APP_ENV=development
DATABASE_URL=sqlite:///./data/platform.db
SESSION_TTL_HOURS=12
CORS_ORIGINS=http://localhost:5173

# Knowledge-base adapters may use an uppercase *_REF name when the upstream
# service requires a credential. Model API keys are entered in the admin UI.
KNOWLEDGEBASE_API_KEY_REF=KNOWLEDGEBASE_API_KEY
KNOWLEDGEBASE_API_KEY=
