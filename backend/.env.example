APP_ENV=development
DATABASE_URL=sqlite:///./data/platform.db
SESSION_TTL_HOURS=12
CORS_ORIGINS=http://localhost:5173

# Runtime provider secret indirection. Profiles refer to *_REF names; values are
# never stored in workflow definitions or request logs.
OPENAI_API_KEY_REF=OPENAI_API_KEY
OPENAI_API_KEY=
KNOWLEDGEBASE_API_KEY_REF=KNOWLEDGEBASE_API_KEY
KNOWLEDGEBASE_API_KEY=
